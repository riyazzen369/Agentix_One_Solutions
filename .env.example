# Copy to .env.local for local development. In production set these in Vercel
# (Project -> Settings -> Environment Variables). Never commit real secrets.

# Public site URL — canonical URLs, sitemap, Open Graph. Use the custom domain once connected.
NEXT_PUBLIC_SITE_URL=https://agentixonesolutions.vercel.app

# Public contact details (also shown on the website)
NEXT_PUBLIC_CONTACT_EMAIL=md.riyazzen369@gmail.com
# digits only, country code first
NEXT_PUBLIC_WHATSAPP_NUMBER=919942721263

# Contact form delivery via Resend (https://resend.com) — SECRETS, keep out of git
RESEND_API_KEY=
# inbox that receives leads
CONTACT_TO_EMAIL=md.riyazzen369@gmail.com
# sender on a domain verified in Resend, e.g. Agentix Leads <leads@yourdomain.com>
CONTACT_FROM_EMAIL=

# Admin page (/admin): the one email allowed to sign in (must also exist as a user in
# Supabase -> Authentication -> Users; database rules in supabase/migrations name the same email)
ADMIN_EMAIL=md.riyazzen369@gmail.com

# Client sign-off storage (Supabase project "agentix-one-solutions", table public.client_signoffs).
# The publishable key can only INSERT (row-level security); it cannot read, edit or delete rows.
SUPABASE_URL=https://kgujijfpoucohmtlrbzn.supabase.co
SUPABASE_PUBLISHABLE_KEY=
