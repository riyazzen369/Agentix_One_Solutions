# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public contact details (leave empty to show [PLACEHOLDER] text)
NEXT_PUBLIC_WHATSAPP_NUMBER=      # digits only with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery via Resend (https://resend.com) — server-only secrets
RESEND_API_KEY=
CONTACT_TO_EMAIL=                 # inbox that receives leads
CONTACT_FROM_EMAIL=               # sender on a domain verified in Resend, e.g. "Agentix Leads <leads@yourdomain.com>"
